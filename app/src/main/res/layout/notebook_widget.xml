<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_stats" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center_vertical" android:textSize="13sp"
            android:textColor="#D7F0EB" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_new" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center" android:paddingHorizontal="8dp" android:text="@string/widget_new_note"
            android:textColor="#A5F2DF" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/widget_recent" android:layout_width="match_parent" android:layout_height="34dp"
        android:gravity="center_vertical" android:textColor="#FFFFFF" android:textSize="14sp"
        android:ellipsize="end" android:maxLines="1" />
    <TextView android:id="@+id/widget_pinned" android:layout_width="match_parent" android:layout_height="34dp"
        android:gravity="center_vertical" android:textColor="#FFFFFF" android:textSize="14sp"
        android:ellipsize="end" android:maxLines="1" />
</LinearLayout>
